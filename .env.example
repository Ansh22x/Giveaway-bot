# ==============================================================================
# ULTRA GIVEAWAY BOT - PRODUCTION CONFIGURATION
# ==============================================================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# PostgreSQL Database URL
# For Neon / Render external PostgreSQL:
# Format: postgresql+asyncpg://user:password@ep-something.region.neon.tech/neondb?ssl=require
# If standard postgres:// or postgresql:// is provided, the app auto-converts to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/giveaway_db?ssl=require

# Webhook Security
# Random high-entropy secret string (1-256 characters: A-Z, a-z, 0-9, _, -)
# Verified against X-Telegram-Bot-Api-Secret-Token on incoming webhook requests
WEBHOOK_SECRET=your_super_secret_webhook_token_here_random_alphanumeric_123

# Public Base URL for Webhook endpoint (Render URL or ngrok domain, without trailing slash)
# Example: https://ultra-giveaway-bot.onrender.com
WEBHOOK_BASE_URL=https://ultra-giveaway-bot.onrender.com

# Primary Admin / Superuser Telegram ID (for system notifications / bootstrap)
ADMIN_CHAT_ID=123456789

# Application Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Server Binding Port (Render provides $PORT automatically, defaults to 8000)
PORT=8000

# Serverless Database Pool Settings (Neon friendly: pool size <= 5, with pre-ping)
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
